POSTGRES_DB=personal_dashboard
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql://dashboard:replace_with_a_long_random_password@postgres:5432/personal_dashboard
REDIS_URL=redis://redis:6379

AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=replace_me
AI_MODEL=replace_me

JWT_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_TOKEN_EXPIRES_IN=7d
PORT=4000
NODE_ENV=production
ENABLE_SWAGGER=false
FRONTEND_URL=https://dashboard.example.com
APP_DOMAIN=dashboard.example.com

DEFAULT_USER_EMAIL=local@example.com
DEFAULT_USER_NAME=本地用户

MICROSOFT_CLIENT_ID=replace_me
MICROSOFT_CLIENT_SECRET=replace_me
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://dashboard.example.com/api/integrations/microsoft-todo/callback
MICROSOFT_SCOPES=offline_access User.Read Tasks.ReadWrite
MICROSOFT_TODO_TIME_ZONE=Asia/Shanghai
